epsilon = 0.01;
a = -2;
b = 4;
T = 10;

h = 0.01;
dt = 0.01;
N = round((b-a)/h);
M = round(T/dt);
x = linspace(a,b,N+1);
h = (b-a)/N;
dt = T/M;

c = 3*sqrt(2)*epsilon/2;
q = @(x,t) 0.5*(1-tanh((x-c*t)/(2*sqrt(2)*epsilon)));
u0 = q(x,0);
u = u0;

r = epsilon^2*dt/h^2;
e = ones(N-1,1);
A = spdiags([-r*e, (1+2*r)*e, -r*e], [-1,0,1], N-1,N-1);

for s = 1:M
    u1 = u;
    rhs = (u(2:end-1) + dt*(u(2:end-1)-u(2:end-1).^3))';

    u1(1) = q(a,s*dt);
    u1(end) = q(b,s*dt);
    rhs(1) = rhs(1) + r*u1(1);
    rhs(end) = rhs(end) + r*u1(end);

    u1(2:end-1) = (A \ rhs)';
    u = u1;
end

figure;
plot(x,u0,'--',x,u,'-');
xlabel('x');
ylabel('u');
legend('Initial profile','Final profile');
grid on;

j = find(u(1:end-1) > 0.5 & u(2:end) <= 0.5,1);
if isempty(j)
    xmid = NaN;
else
    xmid = x(j) + (0.5-u(j))*(x(j+1)-x(j))/(u(j+1)-u(j));
end
cnum = xmid/T;

fprintf('Final wave centre: %.6f\n',xmid);
fprintf('Numerical wave speed: %.6f\n',cnum);
